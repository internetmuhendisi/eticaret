{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git init *)",
      "Bash(git status *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git remote *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git tag *)",
      "Bash(git merge *)",
      "Bash(git branch *)",
      "Bash(git worktree *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push *+*)",
      "Bash(git tag -d *)",
      "Bash(git tag --delete *)",
      "Bash(git tag -f *)",
      "Bash(git tag --force *)",
      "Bash(git branch -D *)",
      "Bash(git branch * -D *)",
      "Bash(git branch -M *)",
      "Bash(git branch * -M *)",
      "Bash(git branch -f *)",
      "Bash(git branch * -f *)",
      "Bash(git branch * -f)",
      "Bash(git branch --force*)",
      "Bash(git branch *--force*)",
      "Bash(git worktree remove --force*)",
      "Bash(git worktree remove *--force*)",
      "Bash(git worktree remove -f*)",
      "Bash(git worktree remove * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -R *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gizli-dosya-kalkani.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gecmis-kalkani.sh"
          }
        ]
      }
    ]
  }
}
