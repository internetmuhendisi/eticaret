# Sunucudaki ön kapı (kart 0020, karar 0032). Caddy isteği adrese göre sitenin kutusuna gönderir,
# adreslerin şifreli bağlantı sertifikasını kendisi alır ve yeniler; şifresiz istek şifreliye yönlenir.
# Her adresin satırı sunucuda /srv/altyapi/on-kapi/siteler/ altındadır (komutlar/on-kapi.mts üretir).
# Yerel ortamın ayarı ayrıdır ve şifresizdir: sunucu/caddy/Caddyfile.
{
	# HTTP/3 UDP 443 ister; duvarlar yalnız TCP 80 ve 443'ü açar (karar 0030).
	servers {
		protocols h1 h2
	}
}

# Arama motorlarına kapalı adresin kuralı. Başlık kutunun cevabından sonra yazılır, kutu başka bir
# değer gönderse de bu kalır. Deneme adresleri her zaman, asıl adres sitenin aramaMotorlarinaAcik
# ayarı kapalıyken alır (karar 0202).
(arama-kapali) {
	header {
		defer
		X-Robots-Tag "noindex, nofollow"
	}
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
" 200
	}
}

# Deneme adreslerinin ortak kuralı (karar 0032): arama motorlarına kapalı.
(deneme) {
	import arama-kapali
}

# Bakım cevabının başlıkları (kart 0043, karar 0038): 503 ve Retry-After arama motorlarına kapanmanın
# geçici olduğunu söyler, sayfa önbelleğe alınmaz. Hata yolunda yukarıdaki kural çalışmaz, deneme
# adresi arama motorlarına kapalı kalsın diye burada da yazılır.
(bakim-basliklari) {
	header {
		Retry-After "300"
		Cache-Control "no-store"
		X-Robots-Tag "noindex, nofollow"
	}
}

import /etc/caddy/siteler/*.caddy

# Tanınmayan adres hiçbir siteye gitmez. Şifreli bağlantıda tanınmayan adrese sertifika verilmez;
# bir sitenin sertifikasıyla bağlanıp istekte başka bir ad yazan da 404 alır.
http:// {
	respond 404
}

https:// {
	respond 404
}
