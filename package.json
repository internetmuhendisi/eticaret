{
  "name": "kok",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "cekirdek": "SITE_KLASORU=\"${SITE_KLASORU:-$PWD/siteler/ornek-magaza}\" pnpm --filter cekirdek-uygulama gelistir",
    "tur-kontrolu": "tsc --noEmit -p tsconfig.json && pnpm -r --no-bail tur-kontrolu",
    "testler": "pnpm birim-testleri && pnpm tarayici-testleri",
    "birim-testleri": "vitest run",
    "tarayici-testleri": "playwright test",
    "denetim": "biome check --error-on-warnings",
    "bicimle": "biome format --write",
    "denetim-kendi-testi": "node denetim/kendi-kendini-denetle.mts",
    "shadcn-farki": "node komutlar/shadcn-farki.mts",
    "katalog-kullanimlari": "node komutlar/katalog-kullanimlari.mts",
    "site-dogrula": "node komutlar/site-dogrula.mts",
    "veritabani-baslat": "docker compose -f sunucu/compose.yaml --env-file .env up -d --wait",
    "veritabani-durdur": "docker compose -f sunucu/compose.yaml --env-file .env down",
    "site-veritabani-ac": "node --env-file=.env komutlar/site-veritabani-ac.mts",
    "yonetici-ac": "node --env-file=.env komutlar/yonetici-ac.mts",
    "sunucu-yonetici-ac": "node komutlar/sunucu-yonetici-ac.mts",
    "sunucu-yonetici-kapat": "node komutlar/sunucu-yonetici-kapat.mts",
    "panel-denemesi": "node komutlar/panel-denemesi.mts",
    "veritabani-degisikligi-uret": "drizzle-kit generate",
    "veritabani-guncelle": "node --env-file=.env komutlar/veritabani-guncelle.mts",
    "cekirdek-goruntusu": "node komutlar/cekirdek-goruntusu.mts",
    "cekirdek-goruntusu-denetle": "node komutlar/cekirdek-goruntusu-denetle.mts",
    "yerel-ortam-ac": "node komutlar/yerel-ortam-ac.mts",
    "yerel-ortam-kapat": "node komutlar/yerel-ortam-kapat.mts",
    "yerel-ortam-testi": "node komutlar/yerel-ortam-testi.mts",
    "guvenlik-taramasi": "pnpm audit --prod --audit-level moderate && pnpm audit --audit-level high",
    "hat-ortami-hazirla": "node komutlar/hat-ortami-hazirla.mts",
    "hat-sonucu": "node komutlar/hat-sonucu.mts",
    "sunucu-kur": "node komutlar/sunucu-kur.mts",
    "sunucu-denetle": "node komutlar/sunucu-denetle.mts",
    "sunucu-gizli": "node komutlar/sunucu-gizli.mts",
    "sunucu-gizli-denemesi": "node komutlar/sunucu-gizli-denemesi.mts",
    "sunucu-veritabani": "node komutlar/sunucu-veritabani-ac.mts",
    "sunucu-veritabani-denemesi": "node komutlar/sunucu-veritabani-denemesi.mts",
    "yayinla": "node komutlar/yayinla.mts",
    "geri-don": "node komutlar/geri-don.mts",
    "yayin-kaydi": "node komutlar/yayin-kaydi.mts",
    "yayin-denemesi": "node komutlar/yayin-denemesi.mts",
    "alan-adi": "node komutlar/alan-adi.mts",
    "sunucu-hata-izleme": "node komutlar/sunucu-hata-izleme.mts",
    "hata-izleme-ac": "node komutlar/hata-izleme-ac.mts",
    "hata-izleme-denemesi": "node komutlar/hata-izleme-denemesi.mts",
    "arka-plan-denemesi": "node komutlar/arka-plan-denemesi.mts",
    "eposta-denemesi": "node --env-file=.env komutlar/eposta-denemesi.mts",
    "bakim": "node komutlar/bakim.mts",
    "bakim-denemesi": "node komutlar/bakim-denemesi.mts",
    "yedek-kur": "node komutlar/yedek-kur.mts",
    "yedek-al": "node komutlar/yedek-al.mts",
    "yedek-kaydi": "node komutlar/yedek-kaydi.mts",
    "yedek-prova": "node komutlar/yedek-prova.mts",
    "yedek-geri-yukle": "node komutlar/yedek-geri-yukle.mts",
    "yedek-denemesi": "node komutlar/yedek-denemesi.mts",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm denetim"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/node": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "altcha-lib": "2.8.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  }
}
