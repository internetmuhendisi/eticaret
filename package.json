{
  "name": "kok",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "cekirdek": "SITE_KLASORU=\"${SITE_KLASORU:-$PWD/siteler/ornek-magaza}\" pnpm --filter cekirdek-uygulama gelistir",
    "tur-kontrolu": "tsc --noEmit -p tsconfig.json && pnpm -r --no-bail tur-kontrolu",
    "testler": "pnpm birim-testleri && pnpm tarayici-testleri",
    "birim-testleri": "vitest run",
    "tarayici-testleri": "playwright test",
    "denetim": "biome check --error-on-warnings",
    "bicimle": "biome format --write",
    "denetim-kendi-testi": "node denetim/kendi-kendini-denetle.mts",
    "site-dogrula": "node komutlar/site-dogrula.mts",
    "veritabani-baslat": "docker compose -f sunucu/compose.yaml --env-file .env up -d --wait",
    "veritabani-durdur": "docker compose -f sunucu/compose.yaml --env-file .env down",
    "site-veritabani-ac": "node --env-file=.env komutlar/site-veritabani-ac.mts",
    "veritabani-degisikligi-uret": "drizzle-kit generate",
    "veritabani-guncelle": "node --env-file=.env komutlar/veritabani-guncelle.mts",
    "cekirdek-goruntusu": "node komutlar/cekirdek-goruntusu.mts",
    "cekirdek-goruntusu-denetle": "node komutlar/cekirdek-goruntusu-denetle.mts",
    "yerel-ortam-ac": "node komutlar/yerel-ortam-ac.mts",
    "yerel-ortam-kapat": "node komutlar/yerel-ortam-kapat.mts",
    "yerel-ortam-testi": "node komutlar/yerel-ortam-testi.mts",
    "guvenlik-taramasi": "pnpm audit --prod --audit-level moderate && pnpm audit --audit-level high",
    "hat-ortami-hazirla": "node komutlar/hat-ortami-hazirla.mts",
    "hat-sonucu": "node komutlar/hat-sonucu.mts",
    "sunucu-kur": "node komutlar/sunucu-kur.mts",
    "sunucu-denetle": "node komutlar/sunucu-denetle.mts",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm denetim"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "jsdom": "30.1.3",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
