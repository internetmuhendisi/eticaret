{
  "name": "kok",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "cekirdek": "pnpm --filter cekirdek-uygulama gelistir",
    "tur-kontrolu": "tsc --noEmit -p tsconfig.json && pnpm -r --no-bail tur-kontrolu",
    "testler": "pnpm birim-testleri && pnpm tarayici-testleri",
    "birim-testleri": "vitest run",
    "tarayici-testleri": "playwright test",
    "denetim": "biome check --error-on-warnings",
    "bicimle": "biome format --write",
    "denetim-kendi-testi": "node denetim/kendi-kendini-denetle.mts",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm denetim"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
