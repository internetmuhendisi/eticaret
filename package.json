{
  "name": "kok",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "tur-kontrolu": "pnpm -r --no-bail tur-kontrolu",
    "denetim": "biome check --error-on-warnings",
    "bicimle": "biome format --write",
    "denetim-kendi-testi": "node denetim/kendi-kendini-denetle.mts",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm denetim"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2"
  }
}
