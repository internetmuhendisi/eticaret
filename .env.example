# Gizli bilgiler (karar 0022). Bu dosyayı .env adıyla kopyalayıp değerleri doldurun.
# .env asla kayda girmez.

# Yerel PostgreSQL kutusu (sunucu/compose.yaml). Port bu bilgisayarda boş bir port olmalı.
VERITABANI_PORTU=55432
VERITABANI_YONETICI_SIFRESI=

# Uygulamanın bağlandığı sitenin veritabanı: postgres://<kullanıcı>:<şifre>@localhost:<port>/<veritabanı>
# Kullanıcı ve veritabanı adı site_<kod adı> biçimindedir, kod adındaki tire alt çizgi olur.
VERITABANI_ADRESI=

# Yerelde tam ortam (pnpm yerel-ortam-ac, karar 0028). Siteler Caddy üzerinden
# http://<kod-adi>.localhost:<port> adresinde açılır. Port bu bilgisayarda boş bir port olmalı.
YEREL_ORTAM_PORTU=58080

# Yerel ortamdaki öteki sitelerin veritabanı adresleri VERITABANI_ADRESI_<KOD_ADI> adıyla durur
# (kod adı büyük harfle, tire alt çizgi olur). Satır yoksa pnpm yerel-ortam-ac şifreyi kendisi
# üretip buraya ekler; elle yazmak gerekmez. VERITABANI_ADRESI'nin ait olduğu site o adresi kullanır.

# Hetzner Cloud API anahtarı (kart 0018, karar 0030): pnpm sunucu-kur ve pnpm sunucu-denetle kullanır.
# Hetzner Cloud Console > proje > Security > API Tokens, "Read & Write" yetkisiyle üretilir.
HETZNER_ANAHTARI=
