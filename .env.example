# Gizli bilgiler (karar 0022). Bu dosyayı .env adıyla kopyalayıp değerleri doldurun.
# .env asla kayda girmez.

# Yerel PostgreSQL kutusu (sunucu/compose.yaml). Port bu bilgisayarda boş bir port olmalı.
VERITABANI_PORTU=55432
VERITABANI_YONETICI_SIFRESI=

# Uygulamanın bağlandığı sitenin veritabanı: postgres://<kullanıcı>:<şifre>@localhost:<port>/<veritabanı>
# Kullanıcı ve veritabanı adı site_<kod adı> biçimindedir, kod adındaki tire alt çizgi olur.
VERITABANI_ADRESI=
