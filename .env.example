# Gizli bilgiler (karar 0022). Bu dosyayı .env adıyla kopyalayıp değerleri doldurun.
# .env asla kayda girmez.

# Yerel PostgreSQL kutusu (sunucu/compose.yaml). Port bu bilgisayarda boş bir port olmalı.
VERITABANI_PORTU=55432
VERITABANI_YONETICI_SIFRESI=

# Uygulamanın bağlandığı sitenin veritabanı: postgres://<kullanıcı>:<şifre>@localhost:<port>/<veritabanı>
# Kullanıcı ve veritabanı adı site_<kod adı> biçimindedir, kod adındaki tire alt çizgi olur.
# Bu dosya yalnız bilgisayar içindir. Sunucuda gizli bilgiler sitenin kendi dosyalarında durur
# ve pnpm sunucu-gizli ile sunucuda üretilir (karar 0031).
VERITABANI_ADRESI=

# Yöneticinin iki aşamalı giriş gizlilerini şifreleyen anahtar (kart 0028, karar 0044): 64 onaltılık
# hane, üretmek için: openssl rand -hex 32. Değişirse kurulu iki aşamalı girişler açılamaz.
IKI_ASAMA_ANAHTARI=

# Yerelde tam ortam (pnpm yerel-ortam-ac, karar 0028). Siteler Caddy üzerinden
# http://<kod-adi>.localhost:<port> adresinde açılır. Port bu bilgisayarda boş bir port olmalı.
YEREL_ORTAM_PORTU=58080

# Yerel ortamdaki öteki sitelerin veritabanı adresleri VERITABANI_ADRESI_<KOD_ADI> adıyla durur
# (kod adı büyük harfle, tire alt çizgi olur). Satır yoksa pnpm yerel-ortam-ac şifreyi kendisi
# üretip buraya ekler; elle yazmak gerekmez. VERITABANI_ADRESI'nin ait olduğu site o adresi kullanır.

# Yerel posta kutusu (sunucu/compose.yaml, kart 0032, karar 0050). E-postalar burada yakalanır, dışarı
# gitmez. Gelenleri görmek: http://localhost:<POSTA_KUTUSU_PORTU>. EPOSTA_SUNUCUSU uygulamanın bağlandığı
# adrestir; gönderici yalnız yerel adresi kabul eder (cekirdek/moduller/eposta/gonderici.ts).
POSTA_SMTP_PORTU=51025
POSTA_KUTUSU_PORTU=58025
EPOSTA_SUNUCUSU=smtp://localhost:51025

# Hetzner Cloud API anahtarı (kart 0018, karar 0030): pnpm sunucu-kur ve pnpm sunucu-denetle kullanır.
# Hetzner Cloud Console > proje > Security > API Tokens, "Read & Write" yetkisiyle üretilir.
HETZNER_ANAHTARI=

# Yedek deposunun anahtarı (kart 0024, karar 0037): pnpm yedek-kur okur, sunucuya yedek işi için kurar.
# Hetzner Console > proje > Security > S3 Credentials > Generate credentials.
YEDEK_DEPO_ERISIM_ANAHTARI=
YEDEK_DEPO_GIZLI_ANAHTARI=

# Cloudflare API anahtarı (kart 0020, karar 0032): pnpm alan-adi deneme adreslerinin kayıtlarını
# kurar. Cloudflare > My Profile > API Tokens > "Edit zone DNS" şablonu, yalnız altyapının alan adı.
CLOUDFLARE_ANAHTARI=
