{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/*.md",
      "!pnpm-lock.yaml",
      "!denetim/bozuk-ornekler",
      "!bilesenler/shadcn-kaynagi",
      "!cekirdek/veritabani/degisiklikler/meta"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "plugins": [
    "./denetim/kurallar/ham-renk.grit",
    "./denetim/kurallar/gomulu-metin.grit",
    "./denetim/kurallar/guvensiz-sorgu.grit",
    "./denetim/kurallar/ham-sql.grit",
    "./denetim/kurallar/execute-sorgu.grit",
    "./denetim/kurallar/elle-bicimlendirme.grit",
    "./denetim/kurallar/elle-form.grit",
    "./denetim/kurallar/serbest-tailwind.grit",
    "./denetim/kurallar/hazir-palet.grit",
    "./denetim/kurallar/satir-ici-olcu.grit",
    "./denetim/kurallar/ham-oge.grit",
    "./denetim/kurallar/ikon-sozlugu.grit"
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      },
      "style": {
        "noJsxLiterals": "error"
      }
    }
  },
  "assist": {
    "enabled": true
  },
  "overrides": [
    {
      "includes": [
        "komutlar/**",
        "denetim/*.mts",
        "cekirdek/izleme/istemci-hata-katmani.ts",
        "cekirdek/izleme/testler/konsol.test.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
